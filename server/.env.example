# ─────────────────────────────────────────────────────────────
# VidrierApp — Backend Environment Variables
# Copiar a .env y ajustar valores antes de levantar con docker compose
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=vidrierapp
POSTGRES_USER=vidrierapp
POSTGRES_PASSWORD=vidrierapp_secret

# Puertos expuestos en el host (cambiar si ya están ocupados)
DB_HOST_PORT=5432
ADMINER_HOST_PORT=8080
API_HOST_PORT=8081

# Ktor API (the Docker database remains available on localhost)
PORT=8081
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/vidrierapp

# JWT signing secret and shared credentials. Generate a long random JWT_SECRET for each deployment.
JWT_SECRET=change-me-before-deploying
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password
USER_USERNAME=user
USER_PASSWORD=change-user-password

# Server-side Google Geocoding API key. Restrict it to the server egress IP in Google Cloud.
MAPS_API_KEY=
